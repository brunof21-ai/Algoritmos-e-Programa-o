{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "Compilar Projeto (Raylib + SQLite)",
            "command": "gcc",
            "args": [
                "-g",
                "main.c",
                "sqlite3.c",
                "-o",
                "${workspaceFolder}/sistema.exe",
                "-I${workspaceFolder}/include",
                "-L${workspaceFolder}/lib",
                "-DWINVER=0x0601",
                "-D_WIN32_WINNT=0x0601",
                "-lraylib",
                "-lopengl32",
                "-lgdi32",
                "-lwinmm"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}